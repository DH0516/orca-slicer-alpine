+// True when running on Wayland with an NVIDIA GPU on driver > 555, where
+// OrcaSlicer's GL init is known to crash. Reads sysfs only, so it needs
+// no GL context and is safe to run before anything else. Replaces the old
+// launcher-script check (same conditions, no glxinfo needed). sysfs_root
+// exists for testing; production callers pass nothing.
+static bool nvidia_wayland_needs_zink(const char *sysfs_root = "/sys")
+{
+    char path[128];
+    const char *session = ::getenv("XDG_SESSION_TYPE");
+    if (session == nullptr || std::strcmp(session, "wayland") != 0)
+        return false;
+    const char *no_zink = ::getenv("ZINK_DISABLE_OVERRIDE");
+    if (no_zink != nullptr && std::strcmp(no_zink, "1") == 0)
+        return false;
+    bool have_nvidia = false;
+    for (int card = 0; card < 16 && ! have_nvidia; ++ card) {
+        std::snprintf(path, sizeof(path), "%s/class/drm/card%d/device/vendor", sysfs_root, card);
+        FILE *f = std::fopen(path, "r");
+        if (f == nullptr)
+            continue;
+        char vendor[16] = { 0 };
+        if (std::fgets(vendor, sizeof(vendor), f) != nullptr && std::strstr(vendor, "10de") != nullptr)
+            have_nvidia = true;
+        std::fclose(f);
+    }
+    if (! have_nvidia)
+        return false;
+    std::snprintf(path, sizeof(path), "%s/module/nvidia/version", sysfs_root);
+    FILE *f = std::fopen(path, "r");
+    if (f == nullptr)
+        return false;
+    int major = 0;
+    bool ok = std::fscanf(f, "%d", &major) == 1;
+    std::fclose(f);
+    return ok && major > 555;
+}
 int main(int argc, char **argv)
 {
 #ifndef _WIN32
@@ -7540,6 +7576,15 @@
     // OrcaSlicer with SIGPIPE (exit 141) and produces no crash report.
     std::signal(SIGPIPE, SIG_IGN);
 #endif
+    if (nvidia_wayland_needs_zink()) {
